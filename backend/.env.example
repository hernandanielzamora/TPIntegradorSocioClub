# Copiar a .env y completar claves locales. Cargar con scripts/load-env.ps1.
# Solo las lineas que comienzan con # son comentarios; # y = son literales en valores.
DB_URL=jdbc:mysql://localhost:3306/socioclub
DB_USERNAME=socioclub_app
DB_PASSWORD=COMPLETAR_CLAVE_DESARROLLO
MYSQL_TEST_DB_URL=jdbc:mysql://localhost:3306/socioclub_test
MYSQL_TEST_DB_USERNAME=socioclub_tests
MYSQL_TEST_DB_PASSWORD=COMPLETAR_CLAVE_PRUEBAS
MYSQL_TEST_ENABLED=true
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500
